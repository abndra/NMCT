{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "admin": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      "uids": { ".read": "auth != null" }
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["categoryId", "createdAt"],
      "$pid": {
        "units": { ".write": false }
      }
    },

    "stock": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "announcements": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "reviews": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$rid": {
        ".write": "(!data.exists() && newData.child('approved').val() === false) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name','text']) && newData.child('text').isString() && newData.child('text').val().length <= 1000"
      }
    },

    "discountCodes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cid": {
        "usedCount": { ".write": true, ".validate": "newData.isNumber()" }
      }
    },

    "orders_counter": {
      ".read": false,
      ".write": true,
      ".validate": "newData.isNumber()"
    },

    "orders": {
      ".indexOn": ["uid", "deviceId", "phoneKey", "createdAt", "status"],
      
      ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (query.orderByChild === 'uid' && auth != null && query.equalTo === auth.uid) || (query.orderByChild === 'deviceId' && query.equalTo != null) || (query.orderByChild === 'phoneKey' && query.equalTo != null)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",

      "$oid": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['items','total','phone','createdAt']) && newData.child('total').isNumber() && newData.child('phone').isString() && newData.child('phone').val().length <= 24",
        "status": { ".validate": "!data.exists() ? newData.val() === 'pending' : (auth != null && root.child('admins').child(auth.uid).val() === true)" },
        "deliveredCodes": { ".validate": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)" },
        "$other": { ".validate": true }
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "banned": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" }
      }
    },

    "visits": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$day": {
        "count": { ".write": true, ".validate": "newData.isNumber()" },
        "pages": { "$page": { ".write": true, ".validate": "newData.isNumber()" } }
      }
    }
  }
}
